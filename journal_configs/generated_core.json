{
  "schema_version": 1,
  "campaign_name": "journal-generated-core-v1",
  "description": "E5 Generated-300 generalization; run development before the frozen held-out block.",
  "timeout_seconds": 7200,
  "controller_grace_seconds": 120,
  "run_order_seed": 20260810,
  "require_clean_worktree": true,
  "required_machine": {
    "profile_id": "conference-gcp-20260723",
    "cpu_model_contains": "Xeon(R) Platinum 8581C",
    "physical_cpu_cores": 4,
    "logical_cpu_cores": 8,
    "system_memory_mb_min": 15000,
    "system_memory_mb_max": 16500,
