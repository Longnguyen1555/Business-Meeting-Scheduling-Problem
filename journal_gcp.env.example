# Copy to journal_gcp.env on the GCP VM. The real file is git-ignored.
# Keep OUTPUT_ROOT on a persistent disk if the VM can be preempted.
# Production configs require the conference profile: Xeon Platinum 8581C,
# 4 physical/8 logical CPUs, 15.0--16.1 GiB RAM, no swap, one run thread.
JOURNAL_VENV=.venv-ubuntu
OUTPUT_ROOT=/mnt/disks/journal-results
UWRMAXSAT_BIN=/absolute/path/to/uwrmaxsat
UWRMAXSAT_SHA256=1af0283ba4ce003dbe3e4ae5b8e0d9bbcaf7fdd46af7b69b0eb4f2089aa4a5e8
CPU_CORE=0
ALLOW_DIRTY=0
RETRY_ERRORS=0
